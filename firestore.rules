rules_version = '2';

/**
 * SHOPRi8 Firestore security rules.
 *
 * Schema these rules assume (see src/lib/types.ts and src/lib/firebase):
 *
 *   users/{uid}         { uid, displayName, email, phoneNumber, photoURL, capabilities[], status, ... }
 *   shops/{shopId}      { ownerId, name, category, status, latitude, longitude, ... }
 *   categories/{id}     { name, description, icon, image, status }
 *   products/{id}       { shopId, name, price, stock, availability, category, imageSource }
 *   addresses/{id}      { userId, label, recipientName, phone, address, ... }
 *   orders/{id}         { customerId, shopId, items[], orderStatus, statusHistory[], ... }
 *   payments/{id}       { orderId, gateway, status, amount, ... }
 *   deliveryTasks/{id}  { orderId, shopId, deliveryWorkerId, status, ... }
 *
 * Roles come from `users/{uid}.capabilities`, never from a second app or a
 * client-supplied role field, and one account may hold several capabilities.
 *
 * Order and delivery-task transitions are enforced here as well as in the client
 * so a stale or tampered client cannot skip a lifecycle state.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helpers
    // -----------------------------------------------------------------------

    function isSignedIn() {
      return isActiveAccount();
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isActiveAccount() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (!('status' in userDoc(request.auth.uid).data)
            || userDoc(request.auth.uid).data.status == 'active');
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function capabilitiesOf(uid) {
      return userDoc(uid).data.capabilities;
    }

    function hasCapability(capability) {
      return isSignedIn()
        && capabilitiesOf(request.auth.uid) is list
        && (capability in capabilitiesOf(request.auth.uid)
            || (capability == 'delivery_worker'
                && 'deliveryWorker' in capabilitiesOf(request.auth.uid)));
    }

    function isCustomer() {
      return hasCapability('customer');
    }

    function isRetailer() {
      return hasCapability('retailer');
    }

    function isWorker() {
      return hasCapability('delivery_worker');
    }

    function isAvailableWorker(uid) {
      let profile = userDoc(uid).data;
      return profile.capabilities is list
        && ('delivery_worker' in profile.capabilities
            || 'deliveryWorker' in profile.capabilities)
        && (!('status' in profile) || profile.status == 'active')
        && (!('available' in profile) || profile.available == true);
    }

    function isAdmin() {
      return hasCapability('admin');
    }

    function retailerApplicationPath(uid) {
      return /databases/$(database)/documents/retailerApplications/$(uid);
    }

    function orderPath(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }

    function deliveryTaskPath(taskId) {
      return /databases/$(database)/documents/deliveryTasks/$(taskId);
    }

    function validOrderHistoryAppend() {
      return resource.data.statusHistory is list
        && request.resource.data.statusHistory is list
        && request.resource.data.statusHistory.size() == resource.data.statusHistory.size() + 1
        && request.resource.data.statusHistory[resource.data.statusHistory.size()].status
          == request.resource.data.orderStatus;
    }

    function validOrderCreate() {
      let data = request.resource.data;
      let addressPath = /databases/$(database)/documents/addresses/$(data.deliveryAddressId);
      return data.keys().hasAll([
          'customerId', 'shopId', 'shopName', 'items', 'subtotal', 'deliveryFee',
          'totalAmount', 'deliveryAddressId', 'deliveryAddress', 'paymentMethod',
          'paymentStatus', 'orderStatus', 'statusHistory', 'createdAt', 'updatedAt'
        ])
        && data.customerId == request.auth.uid
        && isActiveShop(data.shopId)
        && data.shopName is string
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 50
        && data.subtotal is number && data.subtotal >= 0
        && data.deliveryFee is number && data.deliveryFee >= 0
        && data.totalAmount == data.subtotal + data.deliveryFee
        && data.deliveryAddressId is string
        && exists(addressPath)
        && get(addressPath).data.userId == request.auth.uid
        && data.deliveryAddress is map
        && data.deliveryAddress.id == data.deliveryAddressId
        && data.deliveryAddress.userId == request.auth.uid
        && data.deliveryAddress.latitude is number
        && data.deliveryAddress.longitude is number
        && data.paymentMethod == 'COD'
        && data.paymentStatus == 'COD_PENDING'
        && data.orderStatus == 'PLACED'
        && data.statusHistory is list
        && data.statusHistory.size() == 1
        && data.statusHistory[0].status == 'PLACED'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function hasReadyDeliveryTask(orderId) {
      let data = request.resource.data;
      let taskPath = deliveryTaskPath(data.deliveryTaskId);
      return data.deliveryTaskId == 'task-' + orderId
        && existsAfter(taskPath)
        && getAfter(taskPath).data.orderId == orderId
        && getAfter(taskPath).data.shopId == resource.data.shopId
        && getAfter(taskPath).data.status == 'AVAILABLE'
        && !('deliveryWorkerId' in getAfter(taskPath).data);
    }

    function readyTaskMatchesOrder(taskId) {
      let order = getAfter(orderPath(request.resource.data.orderId)).data;
      return request.resource.data.status == 'AVAILABLE'
        && taskId == 'task-' + request.resource.data.orderId
        && !('deliveryWorkerId' in request.resource.data)
        && order.orderStatus == 'READY_FOR_PICKUP'
        && order.deliveryTaskId == taskId
        && order.shopId == request.resource.data.shopId;
    }

    function orderStatusForTask(status) {
      return status == 'DELIVERY_ASSIGNED' ? 'DELIVERY_ASSIGNED'
        : status == 'PICKED_UP' ? 'PICKED_UP'
        : status == 'OUT_FOR_DELIVERY' ? 'OUT_FOR_DELIVERY'
        : status == 'DELIVERED' ? 'DELIVERED'
        : status == 'DELIVERY_FAILED' ? 'DELIVERY_FAILED'
        : '';
    }

    function validAdminOrderDispatch(orderId) {
      let taskPath = deliveryTaskPath(request.resource.data.deliveryTaskId);
      return resource.data.orderStatus == 'READY_FOR_PICKUP'
        && request.resource.data.orderStatus == 'DELIVERY_ASSIGNED'
        && validOrderHistoryAppend()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.deliveryTaskId == resource.data.deliveryTaskId
        && existsAfter(taskPath)
        && getAfter(taskPath).data.orderId == orderId
        && getAfter(taskPath).data.status == 'DELIVERY_ASSIGNED'
        && getAfter(taskPath).data.deliveryWorkerId is string
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['orderStatus', 'statusHistory', 'updatedAt']);
    }

    function approvedApplicationOwnsShop(uid) {
      let application = getAfter(retailerApplicationPath(uid)).data;
      let shopPath = /databases/$(database)/documents/shops/$(application.shopId);
      return existsAfter(retailerApplicationPath(uid))
        && application.applicantUid == uid
        && application.status == 'APPROVED'
        && application.shopId is string
        && existsAfter(shopPath)
        && getAfter(shopPath).data.ownerId == uid
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.capabilities
          .hasAny(['retailer']);
    }

    function addsRetailerCapability() {
      return request.resource.data.capabilities is list
        && 'retailer' in request.resource.data.capabilities
        && !(resource.data.capabilities is list
             && 'retailer' in resource.data.capabilities);
    }

    function validCapabilityList(capabilities) {
      return capabilities is list
        && capabilities.hasOnly(['customer', 'retailer', 'delivery_worker', 'deliveryWorker', 'admin']);
    }

    function retainsLegacyWorkerCapability(newData, oldData) {
      return !('deliveryWorker' in newData.capabilities)
        || (oldData.capabilities is list && 'deliveryWorker' in oldData.capabilities);
    }

    function hasAdminCapability(data) {
      return data.capabilities is list && 'admin' in data.capabilities;
    }

    function validOptionalProfileFields(data) {
      return (!('displayName' in data) || data.displayName is string)
        && (!('email' in data) || data.email == null || data.email is string)
        && (!('phoneNumber' in data) || data.phoneNumber == null || data.phoneNumber is string)
        && (!('photoURL' in data) || data.photoURL == null || data.photoURL is string);
    }

    function validSelfProfileUpdate(uid) {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      return isUser(uid)
        && isActiveAccount()
        && changes.hasOnly([
             'uid', 'displayName', 'email', 'phoneNumber', 'photoURL',
             'status', 'available', 'updatedAt'
           ])
        && request.resource.data.uid == uid
        && (!('uid' in resource.data) || resource.data.uid == uid)
        && validOptionalProfileFields(request.resource.data)
        && (!changes.hasAny(['email'])
            || request.resource.data.email == request.auth.token.get('email', null))
        && (!changes.hasAny(['phoneNumber'])
            || request.resource.data.phoneNumber == request.auth.token.get('phone_number', null))
        && (!changes.hasAny(['status'])
            || (!('status' in resource.data) && request.resource.data.status == 'active'))
        && (!changes.hasAny(['available'])
            || (isWorker() && request.resource.data.available is bool))
        && (!changes.hasAny(['updatedAt']) || request.resource.data.updatedAt == request.time);
    }

    function validAdminProfileUpdate(uid) {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin()
        && changes.hasOnly(['capabilities', 'status', 'displayName', 'email', 'phoneNumber', 'photoURL', 'updatedAt'])
        && request.resource.data.uid == uid
        && validCapabilityList(request.resource.data.capabilities)
        && request.resource.data.status in ['active', 'suspended']
        && hasAdminCapability(request.resource.data) == hasAdminCapability(resource.data)
        && retainsLegacyWorkerCapability(request.resource.data, resource.data)
        && (!addsRetailerCapability() || approvedApplicationOwnsShop(uid))
        && validOptionalProfileFields(request.resource.data)
        && (!changes.hasAny(['updatedAt']) || request.resource.data.updatedAt == request.time);
    }

    /** True when the signed-in retailer owns this shop document. */
    function ownsShop(shopId) {
      return isRetailer()
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
    }

    /** Retailer owns the shop this document belongs to. */
    function ownsShopOfProduct(productData) {
      return isRetailer() && ownsShop(productData.shopId);
    }

    function isActiveShop(shopId) {
      return exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.status == 'ACTIVE';
    }

    function validShop(data) {
      return data.keys().hasOnly([
          'ownerId', 'name', 'category', 'description', 'image', 'phone', 'address',
          'latitude', 'longitude', 'openingTime', 'closingTime', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll(['ownerId', 'name', 'category', 'address', 'status'])
        && data.ownerId is string
        && data.name is string && data.name.size() > 0
        && data.category in [
          'grocery', 'fruits-vegetables', 'flowers', 'pharmacy', 'bakery',
          'stationery', 'hardware', 'fashion', 'electronics', 'household',
          'meat-fish', 'other'
        ]
        && data.address is string
        && data.status in ['ACTIVE', 'INACTIVE', 'SUSPENDED']
        && (!('description' in data) || data.description is string)
        && (!('image' in data) || data.image is string)
        && (!('phone' in data) || data.phone is string)
        && (!('latitude' in data) || data.latitude is number)
        && (!('longitude' in data) || data.longitude is number)
        && (!('openingTime' in data) || data.openingTime is string)
        && (!('closingTime' in data) || data.closingTime is string);
    }

    function validRetailerApplication(data, applicantUid) {
      return data.keys().hasOnly([
          'applicantUid', 'applicantName', 'applicantEmail', 'applicantPhone',
          'shopName', 'category', 'description', 'shopPhone', 'address', 'city',
          'state', 'postalCode', 'openingTime', 'closingTime', 'status',
          'createdAt', 'updatedAt', 'reviewedAt', 'reviewedBy',
          'rejectionReason', 'shopId'
        ])
        && data.keys().hasAll([
          'applicantUid', 'applicantName', 'applicantEmail', 'applicantPhone',
          'shopName', 'category', 'description', 'shopPhone', 'address', 'city',
          'state', 'postalCode', 'openingTime', 'closingTime', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.applicantUid == applicantUid
        && data.applicantName is string && data.applicantName.size() > 0
        && data.applicantEmail is string && data.applicantEmail.size() > 3
        && data.applicantPhone is string && data.applicantPhone.size() >= 7
        && data.shopName is string && data.shopName.size() > 0
        && data.category in [
          'grocery', 'fruits-vegetables', 'flowers', 'pharmacy', 'bakery',
          'stationery', 'hardware', 'fashion', 'electronics', 'household',
          'meat-fish', 'other'
        ]
        && data.description is string && data.description.size() > 0
        && data.shopPhone is string && data.shopPhone.size() >= 7
        && data.address is string && data.address.size() > 0
        && data.city is string && data.city.size() > 0
        && data.state is string && data.state.size() > 0
        && data.postalCode is string && data.postalCode.size() >= 4
        && data.openingTime is string && data.openingTime.size() == 5
        && data.closingTime is string && data.closingTime.size() == 5
        && data.status in ['PENDING', 'APPROVED', 'REJECTED'];
    }

    function validProductImage(data, productId) {
      return !('imageSource' in data)
        || data.imageSource == null
        || (data.imageSource is map
            && data.imageSource.keys().hasOnly(['type', 'ref', 'storagePath', 'name'])
            && data.imageSource.type in ['catalog', 'uploaded']
            && data.imageSource.ref is string
            && data.imageSource.ref.size() > 0
            && (!('name' in data.imageSource) || data.imageSource.name is string)
            && (data.imageSource.type == 'catalog'
                ? !('storagePath' in data.imageSource)
                : ((!('storagePath' in data.imageSource)
                    && data.imageSource.ref.matches('^shopri8-upload:[A-Za-z0-9_-]+$'))
                  || (data.imageSource.storagePath is string
                      && data.imageSource.storagePath.matches(
                        '^shops/' + data.shopId + '/products/' + productId
                        + '/image-[A-Za-z0-9_-]+[.](jpg|png|webp)$'
                      )))));
    }

    function validProduct(data, productId) {
      return data.keys().hasOnly([
          'shopId', 'name', 'description', 'category', 'price', 'stock',
          'availability', 'image', 'imageSource', 'unit', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'shopId', 'name', 'category', 'price', 'stock', 'availability', 'updatedAt'
        ])
        && data.shopId is string
        && data.name is string && data.name.size() > 0
        && data.category in [
          'grocery', 'fruits-vegetables', 'flowers', 'pharmacy', 'bakery',
          'stationery', 'hardware', 'fashion', 'electronics', 'household',
          'meat-fish', 'other'
        ]
        && data.price is number && data.price >= 0
        && data.stock is int && data.stock >= 0
        && data.availability is bool
        && (!data.availability || data.stock > 0)
        && (!('description' in data) || data.description is string)
        && (!('image' in data) || data.image is string)
        && (!('unit' in data) || data.unit is string)
        && validProductImage(data, productId);
    }

    /**
     * Legal order transitions, mirrored from `src/lib/retailerStore.tsx` and
     * `src/lib/workerStore.tsx`.
     *
     * Checking only "is the target status in my allowed set" is not enough: that
     * lets a client skip states, for example DELIVERY_ASSIGNED straight to
     * OUT_FOR_DELIVERY. Both the current and the next status are pinned here so
     * the lifecycle cannot be jumped.
     */
    function validOrderTransition(from, to) {
      return (from == 'PLACED'                && to == 'RETAILER_REVIEW')
          || (from == 'RETAILER_REVIEW'       && to in ['ACCEPTED', 'REJECTED'])
          || (from == 'ACCEPTED'              && to == 'PREPARING')
          || (from == 'PREPARING'             && to == 'READY_FOR_PICKUP')
          || (from == 'READY_FOR_PICKUP'      && to == 'DELIVERY_ASSIGNED')
          || (from == 'DELIVERY_ASSIGNED'     && to == 'PICKED_UP')
          || (from == 'PICKED_UP'             && to == 'OUT_FOR_DELIVERY')
          || (from == 'OUT_FOR_DELIVERY'      && to in ['DELIVERED', 'DELIVERY_FAILED']);
    }

    function validRetailerTransition(from, to) {
      return (from == 'PLACED'          && to == 'RETAILER_REVIEW')
          || (from == 'RETAILER_REVIEW' && to in ['ACCEPTED', 'REJECTED'])
          || (from == 'ACCEPTED'        && to == 'PREPARING')
          || (from == 'PREPARING'       && to == 'READY_FOR_PICKUP');
    }

    function retailerMayProcessOrder(data) {
      return data.get('paymentMethod', 'COD') == 'COD'
          || data.get('paymentStatus', 'PENDING') == 'PAID';
    }

    // -----------------------------------------------------------------------
    // users/{uid}
    // -----------------------------------------------------------------------
    match /users/{uid} {
      // A profile is readable by its owner and by admins. Capabilities are
      // personal but admins need them to manage the platform.
      allow read: if isUser(uid) || isAdmin();

      /** New client-created profiles are customers; privileged roles are provisioned separately. */
      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly([
             'uid', 'displayName', 'email', 'phoneNumber', 'photoURL',
             'capabilities', 'status', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.keys().hasAll([
             'uid', 'displayName', 'capabilities', 'status', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.capabilities is list
        && request.resource.data.capabilities.hasOnly(['customer'])
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (!('email' in request.resource.data)
            || request.resource.data.email == request.auth.token.get('email', null))
        && (!('phoneNumber' in request.resource.data)
            || request.resource.data.phoneNumber == request.auth.token.get('phone_number', null))
        && validOptionalProfileFields(request.resource.data);

      /**
       * Users may edit only safe identity fields. Admins may provision other
       * capabilities and status, but admin grants stay server-side.
       */
      allow update: if validSelfProfileUpdate(uid) || validAdminProfileUpdate(uid);
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // retailerApplications/{applicantUid}
    // -----------------------------------------------------------------------
    match /retailerApplications/{applicantUid} {
      allow read: if isUser(applicantUid) || isAdmin();

      allow create: if isUser(applicantUid)
        && isCustomer()
        && validRetailerApplication(request.resource.data, applicantUid)
        && request.resource.data.status == 'PENDING'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !('reviewedAt' in request.resource.data)
        && !('reviewedBy' in request.resource.data)
        && !('rejectionReason' in request.resource.data)
        && !('shopId' in request.resource.data);

      allow update: if (
          isUser(applicantUid)
          && isCustomer()
          && resource.data.status == 'REJECTED'
          && request.resource.data.status == 'PENDING'
          && validRetailerApplication(request.resource.data, applicantUid)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && !('reviewedAt' in request.resource.data)
          && !('reviewedBy' in request.resource.data)
          && !('rejectionReason' in request.resource.data)
          && !('shopId' in request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'applicantName', 'applicantEmail', 'applicantPhone', 'shopName',
            'category', 'description', 'shopPhone', 'address', 'city', 'state',
            'postalCode', 'openingTime', 'closingTime', 'status', 'updatedAt',
            'reviewedAt', 'reviewedBy', 'rejectionReason', 'shopId'
          ])
        )
        || (
          isAdmin()
          && resource.data.status == 'PENDING'
          && request.resource.data.applicantUid == applicantUid
          && request.resource.data.status in ['APPROVED', 'REJECTED']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'reviewedBy', 'reviewedAt', 'updatedAt',
            'rejectionReason', 'shopId'
          ])
          && (
            (request.resource.data.status == 'APPROVED'
              && !('rejectionReason' in request.resource.data)
              && approvedApplicationOwnsShop(applicantUid))
            || (request.resource.data.status == 'REJECTED'
              && request.resource.data.rejectionReason is string
              && request.resource.data.rejectionReason.size() >= 5
              && !('shopId' in request.resource.data))
          )
        );

      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // shops/{shopId}
    // -----------------------------------------------------------------------
    match /shops/{shopId} {
      // The public storefront may read ACTIVE shops and browse them.
      allow read: if resource.data.status == 'ACTIVE'
        || (isRetailer() && resource.data.ownerId == request.auth.uid)
        || isAdmin();

      // Shop creation is reserved for trusted admins; retailers are linked to
      // a pre-provisioned shop and cannot claim or duplicate shop records.
      allow create: if isAdmin()
        && validShop(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // The owning retailer may edit their own shop, but may not hand it to
      // another account. Admins may edit anything.
      allow update: if isAdminProfileShopUpdate()
        || (ownsShop(shopId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'category', 'description', 'image', 'address', 'latitude',
              'longitude', 'openingTime', 'closingTime', 'status', 'updatedAt'
            ])
            && request.resource.data.ownerId == resource.data.ownerId
            && (!('createdAt' in resource.data)
                || request.resource.data.createdAt == resource.data.createdAt)
            && request.resource.data.status in ['ACTIVE', 'INACTIVE']
            && validShop(request.resource.data)
            && request.resource.data.updatedAt == request.time);

      allow delete: if isAdmin();

      function isAdminProfileShopUpdate() {
        return isAdmin()
          && validShop(request.resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && (!('createdAt' in resource.data)
              || request.resource.data.createdAt == resource.data.createdAt)
          && request.resource.data.updatedAt == request.time;
      }
    }

    // -----------------------------------------------------------------------
    // categories/{categoryId}
    // -----------------------------------------------------------------------
    match /categories/{categoryId} {
      // Shared taxonomy: publicly readable, admin-managed.
      allow read: if resource.data.status == 'ACTIVE' || isAdmin();
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // products/{productId}
    // -----------------------------------------------------------------------
    match /products/{productId} {
      // Public products must be purchasable and belong to an active shop.
      allow read: if (resource.data.availability == true
                      && resource.data.stock > 0
                      && isActiveShop(resource.data.shopId))
                  || ownsShopOfProduct(resource.data)
                  || isAdmin();

      allow create: if validProduct(request.resource.data, productId)
        && exists(/databases/$(database)/documents/shops/$(request.resource.data.shopId))
        && 'createdAt' in request.resource.data
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (isAdmin() || (isRetailer() && ownsShop(request.resource.data.shopId)));

      allow update: if validProduct(request.resource.data, productId)
        && request.resource.data.shopId == resource.data.shopId
        && (!('createdAt' in resource.data)
            || request.resource.data.createdAt == resource.data.createdAt)
        && request.resource.data.updatedAt == request.time
        && (isAdmin() || (isRetailer() && ownsShopOfProduct(resource.data)));

      allow delete: if isAdmin() || (isRetailer() && ownsShopOfProduct(resource.data));
    }

    // -----------------------------------------------------------------------
    // addresses/{addressId}
    // -----------------------------------------------------------------------
    match /addresses/{addressId} {
      // Strictly private to the owner. On create there is no existing document,
      // so the owner check has to read the incoming data instead of `resource`.
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // -----------------------------------------------------------------------
    // orders/{orderId}
    // -----------------------------------------------------------------------
    match /orders/{orderId} {
      /**
       * Readable by the customer who placed it, the retailer whose shop it is,
       * the worker assigned to its delivery task, and admins.
       */
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.customerId == request.auth.uid)
                  || (isRetailer() && ownsShop(resource.data.shopId))
                  || isAssignedWorker()
                  || isEligibleTaskWorker();

      /**
       * Customers create their own orders. The order must start at a real
       * lifecycle state, and the client-supplied customerId must be the caller.
       */
      allow create: if isCustomer()
        && validOrderCreate();

      /**
       * Updates are the interesting case.
       *
       * A customer may only cancel, and only their own order.
       * A retailer may move an order along the fulfillment half of the flow for
       * their own shop, and may set a rejection reason.
       * A worker may only advance the delivery half, and only for their task.
       * Admin dispatch may only move a ready order alongside a valid assignment.
       *
       * `diff().affectedKeys()` keeps each actor from rewriting fields it has no
       * business touching, such as a retailer changing the price.
       */
      allow update: if (isAdmin() && validAdminOrderDispatch(orderId))
        || (isCustomer() && validCustomerUpdate())
        || (isRetailer() && validRetailerUpdate())
        || (isWorker() && validWorkerUpdate());

      // Nobody deletes an order; cancellation is a status, not a deletion.
      allow delete: if false;

      // ---- order update guards ----

      function validCustomerUpdate() {
        return resource.data.customerId == request.auth.uid
          && resource.data.orderStatus in ['PLACED', 'RETAILER_REVIEW']
          && request.resource.data.orderStatus == 'CANCELLED'
          && validOrderHistoryAppend()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus'])
              || (resource.data.paymentStatus == 'COD_PENDING'
                  && request.resource.data.paymentStatus == 'CANCELLED'))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['orderStatus', 'statusHistory', 'updatedAt', 'paymentStatus']);
      }

      function validRetailerUpdate() {
        let changes = request.resource.data.diff(resource.data).affectedKeys();
        return ownsShop(resource.data.shopId)
          && retailerMayProcessOrder(resource.data)
          && validRetailerTransition(resource.data.orderStatus, request.resource.data.orderStatus)
          && validOrderHistoryAppend()
          && (request.resource.data.orderStatus == 'READY_FOR_PICKUP'
              ? hasReadyDeliveryTask(orderId)
              : !changes.hasAny(['deliveryTaskId']))
          && (request.resource.data.orderStatus != 'REJECTED'
              || (request.resource.data.rejectionReason is string
                  && request.resource.data.rejectionReason.size() > 0))
          && changes
               .hasOnly([
                 'orderStatus', 'statusHistory', 'rejectionReason', 'updatedAt',
                 'deliveryTaskId'
               ]);
      }

      function validWorkerUpdate() {
        return hasAssignedDeliveryTask()
          && validOrderTransition(resource.data.orderStatus, request.resource.data.orderStatus)
          && validOrderHistoryAppend()
          && request.resource.data.orderStatus in [
               'DELIVERY_ASSIGNED', 'PICKED_UP', 'OUT_FOR_DELIVERY', 'DELIVERED', 'DELIVERY_FAILED'
             ]
          && getAfter(deliveryTaskPath(resource.data.deliveryTaskId)).data.status
            == request.resource.data.orderStatus
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['orderStatus', 'statusHistory', 'updatedAt']);
      }

      /**
       * The caller is the `deliveryWorkerId` on this order's delivery task.
       *
       * The task is located through `deliveryTaskId` on the order, because rules
       * cannot run a query for "the task whose orderId matches". An order without
       * that field has no assigned worker and nobody may advance it as a worker.
       */
      function isAssignedWorker() {
        return isWorker() && hasAssignedDeliveryTask();
      }

      function hasAssignedDeliveryTask() {
        return 'deliveryTaskId' in resource.data
          && resource.data.deliveryTaskId is string
          && existsAfter(deliveryTaskPath(resource.data.deliveryTaskId))
          && getAfter(deliveryTaskPath(resource.data.deliveryTaskId)).data.orderId == orderId
          && getAfter(deliveryTaskPath(resource.data.deliveryTaskId)).data.deliveryWorkerId
            == request.auth.uid;
      }

      function isEligibleTaskWorker() {
        return isWorker()
          && 'deliveryTaskId' in resource.data
          && exists(deliveryTaskPath(resource.data.deliveryTaskId))
          && get(deliveryTaskPath(resource.data.deliveryTaskId)).data.orderId == orderId
          && (get(deliveryTaskPath(resource.data.deliveryTaskId)).data.status == 'AVAILABLE'
              || get(deliveryTaskPath(resource.data.deliveryTaskId)).data.deliveryWorkerId
                == request.auth.uid);
      }
    }

    // -----------------------------------------------------------------------
    // deliveryTasks/{taskId}
    // -----------------------------------------------------------------------
    match /deliveryTasks/{taskId} {
      /**
       * Workers may read the open board so they can claim work, plus their own
       * tasks. The owning retailer and admins can read tasks for their shop.
       */
      allow read: if isAdmin()
                  || (isWorker()
                      && (resource.data.status == 'AVAILABLE'
                          || resource.data.deliveryWorkerId == request.auth.uid))
                  || (isRetailer() && ownsShop(resource.data.shopId));

      // Created by the platform when a retailer marks an order ready, or by an
      // admin. Never by a client that is inventing its own delivery work.
      allow create: if (isAdmin() && validDeliveryTaskCreate(taskId))
        || (isRetailer()
            && ownsShop(request.resource.data.shopId)
            && validDeliveryTaskCreate(taskId));

      /**
       * Claiming: an AVAILABLE task with no worker becomes this caller's task.
       * A worker may then move their own task along the delivery flow.
       *
       * `deliveryWorkerId` is checked with `in` rather than `== null` because an
       * unclaimed task omits the field entirely, and reading a missing field
       * raises an error that would fail the whole rule.
       */
      allow update: if validAdminAssignment()
        || (isWorker() && validClaim())
        || (isWorker() && validWorkerAdvance());

      allow delete: if false;

      function validAdminAssignment() {
        let order = getAfter(orderPath(resource.data.orderId)).data;
        return isAdmin()
          && resource.data.status == 'AVAILABLE'
          && !('deliveryWorkerId' in resource.data.keys())
          && request.resource.data.status == 'DELIVERY_ASSIGNED'
          && request.resource.data.deliveryWorkerId is string
          && isAvailableWorker(request.resource.data.deliveryWorkerId)
          && request.resource.data.assignedAt == request.time
          && request.resource.data.updatedAt == request.time
          && order.orderStatus == 'DELIVERY_ASSIGNED'
          && order.deliveryTaskId == taskId
          && order.shopId == resource.data.shopId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'deliveryWorkerId', 'assignedAt', 'updatedAt']);
      }

      function validClaim() {
        let order = getAfter(orderPath(resource.data.orderId)).data;
        return resource.data.status == 'AVAILABLE'
          && !('deliveryWorkerId' in resource.data.keys())
          && isAvailableWorker(request.auth.uid)
          && request.resource.data.status == 'DELIVERY_ASSIGNED'
          && request.resource.data.deliveryWorkerId == request.auth.uid
          && request.resource.data.assignedAt == request.time
          && request.resource.data.updatedAt == request.time
          && order.orderStatus == 'DELIVERY_ASSIGNED'
          && order.deliveryTaskId == taskId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'deliveryWorkerId', 'assignedAt', 'updatedAt']);
      }

      /**
       * Legal task transitions, mirrored from `src/lib/workerStore.tsx`.
       * As with orders, the current status is pinned so a state cannot be
       * skipped.
       */
      function validTaskTransition(from, to) {
        return (from == 'AVAILABLE'          && to == 'DELIVERY_ASSIGNED')
            || (from == 'DELIVERY_ASSIGNED' && to == 'PICKED_UP')
            || (from == 'PICKED_UP'         && to == 'OUT_FOR_DELIVERY')
            || (from == 'OUT_FOR_DELIVERY'  && to in ['DELIVERED', 'DELIVERY_FAILED']);
      }

      function validWorkerAdvance() {
        let changes = request.resource.data.diff(resource.data).affectedKeys();
        let order = getAfter(orderPath(resource.data.orderId)).data;
        return resource.data.deliveryWorkerId == request.auth.uid
          && validTaskTransition(resource.data.status, request.resource.data.status)
          && order.deliveryTaskId == taskId
          && order.orderStatus == orderStatusForTask(request.resource.data.status)
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.status == 'PICKED_UP'
              ? request.resource.data.pickedUpAt == request.time
              : !changes.hasAny(['pickedUpAt']))
          && (request.resource.data.status == 'OUT_FOR_DELIVERY'
              ? request.resource.data.outForDeliveryAt == request.time
              : !changes.hasAny(['outForDeliveryAt']))
          && (request.resource.data.status == 'DELIVERED'
              ? request.resource.data.deliveredAt == request.time
              : !changes.hasAny(['deliveredAt']))
          && (request.resource.data.status == 'DELIVERY_FAILED'
              ? (request.resource.data.failedAt == request.time
                  && request.resource.data.failureReason is string
                  && request.resource.data.failureReason.size() >= 3
                  && request.resource.data.failureReason.size() <= 250)
              : !changes.hasAny(['failedAt', 'failureReason', 'failureNotes', 'failureAt']))
          && changes
               .hasOnly([
                 'status', 'failureReason', 'failureNotes', 'updatedAt',
                 'pickedUpAt', 'outForDeliveryAt', 'deliveredAt', 'failedAt'
               ]);
      }

      function validDeliveryTaskCreate(taskId) {
        return readyTaskMatchesOrder(taskId)
          && request.resource.data.keys().hasOnly([
               'orderId', 'shopId', 'status', 'pickupLocation', 'deliveryLocation',
               'distance', 'deliveryFee', 'createdAt', 'updatedAt'
             ])
          && request.resource.data.keys().hasAll([
               'orderId', 'shopId', 'status', 'pickupLocation', 'deliveryLocation',
               'distance', 'deliveryFee', 'createdAt', 'updatedAt'
             ])
          && request.resource.data.orderId is string
          && request.resource.data.pickupLocation is map
          && request.resource.data.deliveryLocation is map
          && request.resource.data.distance is number
          && request.resource.data.distance > 0
          && request.resource.data.deliveryFee is number
          && request.resource.data.deliveryFee >= 0
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
      }
    }

    // -----------------------------------------------------------------------
    // payments/{paymentId}
    // -----------------------------------------------------------------------
    match /payments/{paymentId} {
      /**
       * Payment records contain provider session identifiers and are only
       * readable by admins. Customer and retailer views use the safe payment
       * method/status copied onto the order. There is no client-side write:
       * the trusted server is the only payment reconciler.
       */
      allow read: if isAdmin();

      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Default deny
    // -----------------------------------------------------------------------
    // Anything not matched above is denied. There is intentionally no
    // `allow read, write: if true` anywhere in this file.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
