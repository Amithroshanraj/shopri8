# SHOPRi8 — environment template
#
# Copy to `.env.local` for local development:
#   cp .env.example .env.local
#
# `.env` and `.env.*` are gitignored. `.env.example` is tracked and must only
# ever contain placeholders or public client values.
#
# Firebase web client values are PUBLISHABLE, not secret. A Firebase web API
# key is safe in a browser bundle; access is controlled by Firebase Security
# Rules, not by hiding the key. Never place service-account JSON, private keys,
# or server service-account private keys in any VITE_* variable — those belong
# in server-side or Cloud Functions configuration only.

# ---------------------------------------------------------------------------
# Data source switch
# ---------------------------------------------------------------------------
# demo     = localStorage demo stores only (current prototype behaviour)
# firebase = Firebase Auth + Firestore (progressive per-domain migration)
# `auto` treats the app as Firebase-backed only when the config below is complete.
VITE_DATA_SOURCE=demo

# ---------------------------------------------------------------------------
# Firebase project — hyperlocal-commerce-c9abd
# Firestore region: asia-south1 (Mumbai)
# Console: https://console.firebase.google.com/project/hyperlocal-commerce-c9abd/settings/general
# The Web app `hyperlocal-commerce-web` values are copied from that page.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hyperlocal-commerce-c9abd.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hyperlocal-commerce-c9abd
VITE_FIREBASE_STORAGE_BUCKET=hyperlocal-commerce-c9abd.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Emulator Suite (local development / testing)
# ---------------------------------------------------------------------------
# Leave false to use the live project. Set true and run
# `npx firebase-tools emulators:start` to develop fully offline.
# When true, the client also honours the *_EMULATOR_HOST variables below.
VITE_USE_FIREBASE_EMULATOR=false

# Emulator host overrides must use VITE_ because browser code reads them.
# Defaults are applied by the app when unset, so these are only needed to
# override the ports.
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ---------------------------------------------------------------------------
# Trusted server bindings (Cloudflare Worker only; never use a VITE_ prefix)
# Configure these as Worker variables/secrets in the server deployment.
# The service-account private key must remain a secret binding.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=hyperlocal-commerce-c9abd
FIREBASE_WEB_API_KEY=
FIREBASE_SERVICE_ACCOUNT_EMAIL=
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional server-side emulator endpoints for trusted API development.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
