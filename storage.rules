rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function activeUser() {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        )
        && (!('status' in firestore.get(
              /databases/(default)/documents/users/$(request.auth.uid)
            ).data)
            || firestore.get(
              /databases/(default)/documents/users/$(request.auth.uid)
            ).data.status == 'active');
    }

    function hasCapability(capability) {
      return activeUser()
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.capabilities is list
        && capability in firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.capabilities;
    }

    function isAdmin() {
      return hasCapability('admin');
    }

    function ownsShop(shopId) {
      return hasCapability('retailer')
        && firestore.exists(/databases/(default)/documents/shops/$(shopId))
        && firestore.get(
          /databases/(default)/documents/shops/$(shopId)
        ).data.ownerId == request.auth.uid;
    }

    function productExistsForShop(shopId, productId) {
      return firestore.exists(
          /databases/(default)/documents/products/$(productId)
        )
        && firestore.get(
          /databases/(default)/documents/products/$(productId)
        ).data.shopId == shopId;
    }

    function mayManageProductImage(shopId, productId) {
      return productExistsForShop(shopId, productId)
        && (isAdmin() || ownsShop(shopId));
    }

    function mayDeleteProductImage(shopId, productId) {
      return (!firestore.exists(
                /databases/(default)/documents/products/$(productId)
              )
              || productExistsForShop(shopId, productId))
        && (isAdmin() || ownsShop(shopId));
    }

    function validImageName(fileName) {
      return fileName.matches('^image-[A-Za-z0-9_-]+[.](jpg|png|webp)$');
    }

    function validImageUpload(fileName) {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && ((fileName.matches('^image-[A-Za-z0-9_-]+[.]jpg$')
              && request.resource.contentType == 'image/jpeg')
            || (fileName.matches('^image-[A-Za-z0-9_-]+[.]png$')
              && request.resource.contentType == 'image/png')
            || (fileName.matches('^image-[A-Za-z0-9_-]+[.]webp$')
              && request.resource.contentType == 'image/webp'));
    }

    function isPublicProductImage(shopId, productId, fileName) {
      return productExistsForShop(shopId, productId)
        && firestore.get(
          /databases/(default)/documents/products/$(productId)
        ).data.availability == true
        && firestore.get(
          /databases/(default)/documents/products/$(productId)
        ).data.stock > 0
        && firestore.exists(/databases/(default)/documents/shops/$(shopId))
        && firestore.get(
          /databases/(default)/documents/shops/$(shopId)
        ).data.status == 'ACTIVE'
        && firestore.get(
          /databases/(default)/documents/products/$(productId)
        ).data.imageSource.storagePath
          == 'shops/' + shopId + '/products/' + productId + '/' + fileName;
    }

    match /shops/{shopId}/products/{productId}/{fileName} {
      allow read: if validImageName(fileName)
        && (isAdmin()
            || ownsShop(shopId)
            || isPublicProductImage(shopId, productId, fileName));

      allow create, update: if validImageName(fileName)
        && mayManageProductImage(shopId, productId)
        && validImageUpload(fileName);

      allow delete: if validImageName(fileName)
        && mayDeleteProductImage(shopId, productId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
