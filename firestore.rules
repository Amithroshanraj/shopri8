rules_version = '2';

/**
 * SHOPRi8 Firestore security rules.
 *
 * Schema these rules assume (see src/lib/types.ts and src/lib/firebase):
 *
 *   users/{uid}         { uid, displayName, email, phoneNumber, photoURL, capabilities[], status, ... }
 *   shops/{shopId}      { ownerId, name, category, status, latitude, longitude, ... }
 *   categories/{id}     { name, description, icon, image, status }
 *   products/{id}       { shopId, name, price, stock, availability, category, imageSource }
 *   addresses/{id}      { userId, label, recipientName, phone, address, ... }
 *   orders/{id}         { customerId, shopId, items[], orderStatus, statusHistory[], ... }
 *   payments/{id}       { orderId, gateway, status, amount, ... }
 *   deliveryTasks/{id}  { orderId, shopId, deliveryWorkerId, status, ... }
 *
 * Roles come from `users/{uid}.capabilities`, never from a second app or a
 * client-supplied role field, and one account may hold several capabilities.
 *
 * Order and delivery-task transitions are enforced here as well as in the client
 * so a stale or tampered client cannot skip a lifecycle state.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helpers
    // -----------------------------------------------------------------------

    function isSignedIn() {
      return isActiveAccount();
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isActiveAccount() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (!('status' in userDoc(request.auth.uid).data)
            || userDoc(request.auth.uid).data.status == 'active');
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function capabilitiesOf(uid) {
      return userDoc(uid).data.capabilities;
    }

    function hasCapability(capability) {
      return isSignedIn()
        && capabilitiesOf(request.auth.uid) is list
        && (capability in capabilitiesOf(request.auth.uid)
            || (capability == 'delivery_worker'
                && 'deliveryWorker' in capabilitiesOf(request.auth.uid)));
    }

    function isCustomer() {
      return hasCapability('customer');
    }

    function isRetailer() {
      return hasCapability('retailer');
    }

    function isWorker() {
      return hasCapability('delivery_worker');
    }

    function isAdmin() {
      return hasCapability('admin');
    }

    function validCapabilityList(capabilities) {
      return capabilities is list
        && capabilities.hasOnly(['customer', 'retailer', 'delivery_worker', 'deliveryWorker', 'admin']);
    }

    function retainsLegacyWorkerCapability(newData, oldData) {
      return !('deliveryWorker' in newData.capabilities)
        || (oldData.capabilities is list && 'deliveryWorker' in oldData.capabilities);
    }

    function hasAdminCapability(data) {
      return data.capabilities is list && 'admin' in data.capabilities;
    }

    function validOptionalProfileFields(data) {
      return (!('displayName' in data) || data.displayName is string)
        && (!('email' in data) || data.email == null || data.email is string)
        && (!('phoneNumber' in data) || data.phoneNumber == null || data.phoneNumber is string)
        && (!('photoURL' in data) || data.photoURL == null || data.photoURL is string);
    }

    function validSelfProfileUpdate(uid) {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      return isUser(uid)
        && isActiveAccount()
        && changes.hasOnly(['uid', 'displayName', 'email', 'phoneNumber', 'photoURL', 'status', 'updatedAt'])
        && request.resource.data.uid == uid
        && (!('uid' in resource.data) || resource.data.uid == uid)
        && validOptionalProfileFields(request.resource.data)
        && (!changes.hasAny(['email'])
            || request.resource.data.email == request.auth.token.get('email', null))
        && (!changes.hasAny(['phoneNumber'])
            || request.resource.data.phoneNumber == request.auth.token.get('phone_number', null))
        && (!changes.hasAny(['status'])
            || (!('status' in resource.data) && request.resource.data.status == 'active'))
        && (!changes.hasAny(['updatedAt']) || request.resource.data.updatedAt == request.time);
    }

    function validAdminProfileUpdate(uid) {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin()
        && changes.hasOnly(['capabilities', 'status', 'displayName', 'email', 'phoneNumber', 'photoURL', 'updatedAt'])
        && request.resource.data.uid == uid
        && validCapabilityList(request.resource.data.capabilities)
        && request.resource.data.status in ['active', 'suspended']
        && hasAdminCapability(request.resource.data) == hasAdminCapability(resource.data)
        && retainsLegacyWorkerCapability(request.resource.data, resource.data)
        && validOptionalProfileFields(request.resource.data)
        && (!changes.hasAny(['updatedAt']) || request.resource.data.updatedAt == request.time);
    }

    /** True when the signed-in retailer owns this shop document. */
    function ownsShop(shopId) {
      return isRetailer()
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
    }

    /** Retailer owns the shop this document belongs to. */
    function ownsShopOfProduct(productData) {
      return isRetailer() && ownsShop(productData.shopId);
    }

    function isActiveShop(shopId) {
      return exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.status == 'ACTIVE';
    }

    function validShop(data) {
      return data.keys().hasOnly([
          'ownerId', 'name', 'category', 'description', 'image', 'address',
          'latitude', 'longitude', 'openingTime', 'closingTime', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll(['ownerId', 'name', 'category', 'address', 'status'])
        && data.ownerId is string
        && data.name is string && data.name.size() > 0
        && data.category in [
          'grocery', 'fruits-vegetables', 'flowers', 'pharmacy', 'bakery',
          'stationery', 'hardware', 'fashion', 'electronics', 'household',
          'meat-fish', 'other'
        ]
        && data.address is string
        && data.status in ['ACTIVE', 'INACTIVE', 'SUSPENDED']
        && (!('description' in data) || data.description is string)
        && (!('image' in data) || data.image is string)
        && (!('latitude' in data) || data.latitude is number)
        && (!('longitude' in data) || data.longitude is number)
        && (!('openingTime' in data) || data.openingTime is string)
        && (!('closingTime' in data) || data.closingTime is string);
    }

    function validProduct(data) {
      return data.keys().hasOnly([
          'shopId', 'name', 'description', 'category', 'price', 'stock',
          'availability', 'image', 'imageSource', 'unit', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'shopId', 'name', 'category', 'price', 'stock', 'availability', 'updatedAt'
        ])
        && data.shopId is string
        && data.name is string && data.name.size() > 0
        && data.category in [
          'grocery', 'fruits-vegetables', 'flowers', 'pharmacy', 'bakery',
          'stationery', 'hardware', 'fashion', 'electronics', 'household',
          'meat-fish', 'other'
        ]
        && data.price is number && data.price >= 0
        && data.stock is int && data.stock >= 0
        && data.availability is bool
        && (!data.availability || data.stock > 0)
        && (!('description' in data) || data.description is string)
        && (!('image' in data) || data.image is string)
        && (!('unit' in data) || data.unit is string)
        && (!('imageSource' in data)
            || (data.imageSource is map
                && data.imageSource.keys().hasOnly(['type', 'ref', 'name'])
                && data.imageSource.type in ['catalog', 'uploaded']
                && data.imageSource.ref is string
                && (!('name' in data.imageSource) || data.imageSource.name is string)));
    }

    /**
     * Legal order transitions, mirrored from `src/lib/retailerStore.tsx` and
     * `src/lib/workerStore.tsx`.
     *
     * Checking only "is the target status in my allowed set" is not enough: that
     * lets a client skip states, for example DELIVERY_ASSIGNED straight to
     * OUT_FOR_DELIVERY. Both the current and the next status are pinned here so
     * the lifecycle cannot be jumped.
     */
    function validOrderTransition(from, to) {
      return (from == 'PLACED'                && to == 'RETAILER_REVIEW')
          || (from == 'RETAILER_REVIEW'       && to in ['ACCEPTED', 'REJECTED'])
          || (from == 'ACCEPTED'              && to == 'PREPARING')
          || (from == 'PREPARING'             && to == 'READY_FOR_PICKUP')
          || (from == 'READY_FOR_PICKUP'      && to == 'DELIVERY_ASSIGNED')
          || (from == 'DELIVERY_ASSIGNED'     && to in ['PICKED_UP', 'DELIVERY_FAILED'])
          || (from == 'PICKED_UP'             && to in ['OUT_FOR_DELIVERY', 'DELIVERY_FAILED'])
          || (from == 'OUT_FOR_DELIVERY'      && to in ['DELIVERED', 'DELIVERY_FAILED']);
    }

    // -----------------------------------------------------------------------
    // users/{uid}
    // -----------------------------------------------------------------------
    match /users/{uid} {
      // A profile is readable by its owner and by admins. Capabilities are
      // personal but admins need them to manage the platform.
      allow read: if isUser(uid) || isAdmin();

      /** New client-created profiles are customers; privileged roles are provisioned separately. */
      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly([
             'uid', 'displayName', 'email', 'phoneNumber', 'photoURL',
             'capabilities', 'status', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.keys().hasAll([
             'uid', 'displayName', 'capabilities', 'status', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.capabilities is list
        && request.resource.data.capabilities.hasOnly(['customer'])
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (!('email' in request.resource.data)
            || request.resource.data.email == request.auth.token.get('email', null))
        && (!('phoneNumber' in request.resource.data)
            || request.resource.data.phoneNumber == request.auth.token.get('phone_number', null))
        && validOptionalProfileFields(request.resource.data);

      /**
       * Users may edit only safe identity fields. Admins may provision other
       * capabilities and status, but admin grants stay server-side.
       */
      allow update: if validSelfProfileUpdate(uid) || validAdminProfileUpdate(uid);
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // shops/{shopId}
    // -----------------------------------------------------------------------
    match /shops/{shopId} {
      // The public storefront may read ACTIVE shops and browse them.
      allow read: if resource.data.status == 'ACTIVE'
        || (isRetailer() && resource.data.ownerId == request.auth.uid)
        || isAdmin();

      // Shop creation is reserved for trusted admins; retailers are linked to
      // a pre-provisioned shop and cannot claim or duplicate shop records.
      allow create: if isAdmin()
        && validShop(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // The owning retailer may edit their own shop, but may not hand it to
      // another account. Admins may edit anything.
      allow update: if isAdminProfileShopUpdate()
        || (ownsShop(shopId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'category', 'description', 'image', 'address', 'latitude',
              'longitude', 'openingTime', 'closingTime', 'status', 'updatedAt'
            ])
            && request.resource.data.ownerId == resource.data.ownerId
            && (!('createdAt' in resource.data)
                || request.resource.data.createdAt == resource.data.createdAt)
            && request.resource.data.status in ['ACTIVE', 'INACTIVE']
            && validShop(request.resource.data)
            && request.resource.data.updatedAt == request.time);

      allow delete: if isAdmin();

      function isAdminProfileShopUpdate() {
        return isAdmin()
          && validShop(request.resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && (!('createdAt' in resource.data)
              || request.resource.data.createdAt == resource.data.createdAt)
          && request.resource.data.updatedAt == request.time;
      }
    }

    // -----------------------------------------------------------------------
    // categories/{categoryId}
    // -----------------------------------------------------------------------
    match /categories/{categoryId} {
      // Shared taxonomy: publicly readable, admin-managed.
      allow read: if resource.data.status == 'ACTIVE' || isAdmin();
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // products/{productId}
    // -----------------------------------------------------------------------
    match /products/{productId} {
      // Public products must be purchasable and belong to an active shop.
      allow read: if (resource.data.availability == true
                      && resource.data.stock > 0
                      && isActiveShop(resource.data.shopId))
                  || ownsShopOfProduct(resource.data)
                  || isAdmin();

      allow create: if validProduct(request.resource.data)
        && exists(/databases/$(database)/documents/shops/$(request.resource.data.shopId))
        && 'createdAt' in request.resource.data
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (isAdmin() || (isRetailer() && ownsShop(request.resource.data.shopId)));

      allow update: if validProduct(request.resource.data)
        && request.resource.data.shopId == resource.data.shopId
        && (!('createdAt' in resource.data)
            || request.resource.data.createdAt == resource.data.createdAt)
        && request.resource.data.updatedAt == request.time
        && (isAdmin() || (isRetailer() && ownsShopOfProduct(resource.data)));

      allow delete: if isAdmin() || (isRetailer() && ownsShopOfProduct(resource.data));
    }

    // -----------------------------------------------------------------------
    // addresses/{addressId}
    // -----------------------------------------------------------------------
    match /addresses/{addressId} {
      // Strictly private to the owner. On create there is no existing document,
      // so the owner check has to read the incoming data instead of `resource`.
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // -----------------------------------------------------------------------
    // orders/{orderId}
    // -----------------------------------------------------------------------
    match /orders/{orderId} {
      /**
       * Readable by the customer who placed it, the retailer whose shop it is,
       * the worker assigned to its delivery task, and admins.
       */
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.customerId == request.auth.uid)
                  || (isRetailer() && ownsShop(resource.data.shopId))
                  || isAssignedWorker();

      /**
       * Customers create their own orders. The order must start at a real
       * lifecycle state, and the client-supplied customerId must be the caller.
       */
      allow create: if isSignedIn()
        && isCustomer()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.orderStatus == 'PLACED';

      /**
       * Updates are the interesting case.
       *
       * A customer may only cancel, and only their own order.
       * A retailer may move an order along the fulfillment half of the flow for
       * their own shop, and may set a rejection reason.
       * A worker may only advance the delivery half, and only for their task.
       * An admin may do any of these.
       *
       * `diff().affectedKeys()` keeps each actor from rewriting fields it has no
       * business touching, such as a retailer changing the price.
       */
      allow update: if isAdmin() || validCustomerUpdate() || validRetailerUpdate() || validWorkerUpdate();

      // Nobody deletes an order; cancellation is a status, not a deletion.
      allow delete: if isAdmin();

      // ---- order update guards ----

      function validCustomerUpdate() {
        return isSignedIn()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.orderStatus == 'CANCELLED'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['orderStatus', 'statusHistory', 'updatedAt']);
      }

      function validRetailerUpdate() {
        return isRetailer()
          && ownsShop(resource.data.shopId)
          && validOrderTransition(resource.data.orderStatus, request.resource.data.orderStatus)
          && request.resource.data.orderStatus in [
               'RETAILER_REVIEW', 'ACCEPTED', 'PREPARING', 'READY_FOR_PICKUP', 'REJECTED'
             ]
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'orderStatus', 'statusHistory', 'rejectionReason', 'updatedAt',
                 'paymentStatus'
               ]);
      }

      function validWorkerUpdate() {
        return isAssignedWorker()
          && validOrderTransition(resource.data.orderStatus, request.resource.data.orderStatus)
          && request.resource.data.orderStatus in [
               'DELIVERY_ASSIGNED', 'PICKED_UP', 'OUT_FOR_DELIVERY', 'DELIVERED', 'DELIVERY_FAILED'
             ]
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['orderStatus', 'statusHistory', 'updatedAt']);
      }

      /**
       * The caller is the `deliveryWorkerId` on this order's delivery task.
       *
       * The task is located through `deliveryTaskId` on the order, because rules
       * cannot run a query for "the task whose orderId matches". An order without
       * that field has no assigned worker and nobody may advance it as a worker.
       */
      function isAssignedWorker() {
        return isWorker()
          && 'deliveryTaskId' in resource.data
          && resource.data.deliveryTaskId is string
          && exists(/databases/$(database)/documents/deliveryTasks/$(resource.data.deliveryTaskId))
          && get(/databases/$(database)/documents/deliveryTasks/$(resource.data.deliveryTaskId))
               .data.deliveryWorkerId == request.auth.uid;
      }
    }

    // -----------------------------------------------------------------------
    // deliveryTasks/{taskId}
    // -----------------------------------------------------------------------
    match /deliveryTasks/{taskId} {
      /**
       * Workers may read the open board so they can claim work, plus their own
       * tasks. The owning retailer and admins can read tasks for their shop.
       */
      allow read: if isAdmin()
                  || isWorker()
                  || (isRetailer() && ownsShop(resource.data.shopId))
                  || (isSignedIn() && resource.data.deliveryWorkerId == request.auth.uid);

      // Created by the platform when a retailer marks an order ready, or by an
      // admin. Never by a client that is inventing its own delivery work.
      allow create: if isAdmin() || (isRetailer() && ownsShop(request.resource.data.shopId));

      /**
       * Claiming: an AVAILABLE task with no worker becomes this caller's task.
       * A worker may then move their own task along the delivery flow.
       *
       * `deliveryWorkerId` is checked with `in` rather than `== null` because an
       * unclaimed task omits the field entirely, and reading a missing field
       * raises an error that would fail the whole rule.
       */
      allow update: if isAdmin() || validClaim() || validWorkerAdvance();

      allow delete: if isAdmin();

      function validClaim() {
        return isWorker()
          && resource.data.status == 'AVAILABLE'
          && !('deliveryWorkerId' in resource.data.keys())
          && request.resource.data.status == 'DELIVERY_ASSIGNED'
          && request.resource.data.deliveryWorkerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'deliveryWorkerId', 'updatedAt']);
      }

      /**
       * Legal task transitions, mirrored from `src/lib/workerStore.tsx`.
       * As with orders, the current status is pinned so a state cannot be
       * skipped.
       */
      function validTaskTransition(from, to) {
        return (from == 'AVAILABLE'          && to == 'DELIVERY_ASSIGNED')
            || (from == 'DELIVERY_ASSIGNED' && to in ['PICKED_UP', 'DELIVERY_FAILED'])
            || (from == 'PICKED_UP'         && to in ['OUT_FOR_DELIVERY', 'DELIVERY_FAILED'])
            || (from == 'OUT_FOR_DELIVERY'  && to in ['DELIVERED', 'DELIVERY_FAILED']);
      }

      function validWorkerAdvance() {
        return isWorker()
          && resource.data.deliveryWorkerId == request.auth.uid
          && validTaskTransition(resource.data.status, request.resource.data.status)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'status', 'failureReason', 'failureNotes', 'failureAt', 'updatedAt'
               ]);
      }
    }

    // -----------------------------------------------------------------------
    // payments/{paymentId}
    // -----------------------------------------------------------------------
    match /payments/{paymentId} {
      /**
       * Payments are readable by the customer who paid, the shop that received
       * them, and admins. There is no client-side create or update: gateway
       * callbacks are written by Cloud Functions using the Admin SDK, which
       * bypasses these rules.
       */
      allow read: if isAdmin()
                  || (isSignedIn() && getOrderCustomerId(resource.data.orderId)
                      == request.auth.uid)
                  || (isRetailer() && ownsShop(getOrderShopId(resource.data.orderId)));

      allow write: if false;
    }

    function getOrderDoc(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId));
    }

    function getOrderCustomerId(orderId) {
      return exists(/databases/$(database)/documents/orders/$(orderId))
        ? getOrderDoc(orderId).data.customerId
        : null;
    }

    function getOrderShopId(orderId) {
      return exists(/databases/$(database)/documents/orders/$(orderId))
        ? getOrderDoc(orderId).data.shopId
        : null;
    }

    // -----------------------------------------------------------------------
    // Default deny
    // -----------------------------------------------------------------------
    // Anything not matched above is denied. There is intentionally no
    // `allow read, write: if true` anywhere in this file.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
